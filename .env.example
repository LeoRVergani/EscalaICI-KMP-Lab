# Escala ICI — variáveis de ambiente do build Web/PWA (FASE 14b em diante).
# Nenhuma dessas variáveis é lida pelo build atual (Kotlin/Wasm via Gradle,
# scripts/build-web.sh) — este arquivo é scaffolding para quando o MSAL Web
# (SPA) e/ou Firebase Auth forem implementados. Copie para `.env` (ignorado
# pelo Git) e preencha só quando essa fase começar.

# MSAL / Entra ID (Web SPA) — cadastro separado do Android, ver spec 46.
ESCALAICI_MSAL_TENANT_ID=<MSAL_TENANT_ID>
ESCALAICI_MSAL_CLIENT_ID=<MSAL_CLIENT_ID>
ESCALAICI_MSAL_REDIRECT_URI=<WEB_REDIRECT_URI_PRODUCTION_CLOUDFLARE>

# Firebase (projeto compartilhado com o Dashboard) — não usado enquanto o
# acesso for só via FirestoreRestGateway (REST puro, sem SDK/Custom Token).
ESCALAICI_FIREBASE_PROJECT_ID=<FIREBASE_PROJECT_ID>
