rules_version = '2';

// MVP Firebase dev transitorio:
// - leitura REST sem Firebase Auth apenas dos workspaces publicados permitidos;
// - nenhuma escrita do cliente;
// - Admin SDK do backend continua publicando porque ignora regras de cliente.
service cloud.firestore {
  match /databases/{database}/documents {
    function allowedWorkspace(workspaceId) {
      return workspaceId in ['demo-v1', 'ici-dev'];
    }

    match /workspaces/{workspaceId} {
      allow read: if allowedWorkspace(workspaceId);
      allow write: if false;

      match /revisions/{revision}/{document=**} {
        allow read: if allowedWorkspace(workspaceId);
        allow write: if false;
      }
    }

    match /system_admins/{document=**} {
      allow read, write: if false;
    }

    match /user_links/{document=**} {
      allow read, write: if false;
    }

    match /source_files/{document=**} {
      allow read, write: if false;
    }

    match /import_jobs/{document=**} {
      allow read, write: if false;
    }

    match /credentials/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
